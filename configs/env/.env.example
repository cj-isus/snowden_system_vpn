# ─────────────────────────────────────────────────────────────
# Пример конфигурации окружения. Скопируй в `.env` и заполни.
# Реальный `.env` НЕ пушить (см. .gitignore).
#
#   copy .env.example .env
# ─────────────────────────────────────────────────────────────

# Токен Telegram-бота (от @BotFather)
SNOWDEN_TG_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Твой Telegram user ID (для админ-режима)
SNOWDEN_TG_CHAT_ID=123456789

# Адрес VPS, где лежат файлы для раздачи ботом (лендинг, zip, конфиги)
SNOWDEN_FILE_URL=http://YOUR_VPS_IP:8090