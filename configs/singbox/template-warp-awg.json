{
  "_comment": "AmneziaWG (WARP) template — generate YOUR OWN keys via https://github.com/beeyev/warp-reg or amnezia-wg-tools. Replace all YOUR_* values below. The public_key below is the shared Cloudflare WARP peer public key (same for everyone).",
  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "cloudflare",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "proxy"
      },
      {
        "type": "local",
        "tag": "local",
        "detour": "direct"
      }
    ],
    "rules": [
      { "outbound": "any", "server": "local" }
    ],
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 20808
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "warp-awg",
      "system": false,
      "mtu": 1280,
      "address": ["YOUR_WARP_IPV4/32", "YOUR_WARP_IPV6/128"],
      "private_key": "YOUR_WARP_PRIVATE_KEY_BASE64",
      "peers": [
        {
          "address": "162.159.192.1",
          "port": 4500,
          "public_key": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH00JuVo51h2wPfgyo=",
          "allowed_ips": ["0.0.0.0/0", "::/0"],
          "persistent_keepalive_interval": 25
        }
      ],
      "jc": 4,
      "jmin": 40,
      "jmax": 70,
      "s1": 0,
      "s2": 0,
      "s3": 0,
      "s4": 0,
      "h1": 1,
      "h2": 2,
      "h3": 3,
      "h4": 4,
      "i1": "YOUR_AMNEZIA_I1_HEX_BLOB"
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" },
    { "type": "block", "tag": "block" }
  ],
  "route": {
    "rules": [
      { "action": "sniff" },
      { "action": "hijack-dns", "inbound": "mixed-in" },
      { "ip_is_private": true, "action": "direct" }
    ],
    "final": "warp-awg",
    "default_domain_resolver": "local",
    "auto_detect_interface": true
  }
}
