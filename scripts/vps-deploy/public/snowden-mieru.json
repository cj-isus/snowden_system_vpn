{
  "log": {"level": "info"},
  "dns": {
    "servers": [
      {"type": "https", "tag": "remote", "server": "1.1.1.1", "detour": "mieru-out"},
      {"type": "local", "tag": "local", "detour": "direct"}
    ],
    "rules": [{"outbound": "any", "server": "local"}],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {"type": "tun", "tag": "tun-in", "address": ["172.19.0.1/30"], "mtu": 1500, "auto_route": true, "strict_route": false, "stack": "system"}
  ],
  "outbounds": [
    {
      "type": "mieru",
      "tag": "mieru-out",
      "server": "YOUR_VPS_IP",
      "server_port": 8964,
      "username": "snowden",
      "password": "YOUR_MIERU_PASSWORD",
      "transport": "TCP"
    },
    {"type": "direct", "tag": "direct"},
    {"type": "block", "tag": "block"}
  ],
  "route": {
    "rules": [
      {"action": "sniff"},
      {"domain_suffix": [".ru", ".su", ".рф"], "action": "direct"},
      {"domain": ["yandex.ru","ya.ru","vk.com","mail.ru","ok.ru","gosuslugi.ru","sberbank.ru","sber.ru","tinkoff.ru","vtb.ru","alfabank.ru","passport.yandex.ru"],
        "action": "direct"},
      {"domain": ["t.me", "telegram.org"], "outbound": "mieru-out"},
      {"domain_suffix": ["googlevideo.com","youtube.com","youtu.be","gstatic.com","discord.com","openai.com","claude.ai","chatgpt.com","twitter.com","x.com","instagram.com","aliexpress.com","amazon.com"],
        "outbound": "mieru-out"},
      {"ip_is_private": true, "action": "direct"}
    ],
    "final": "mieru-out",
    "default_domain_resolver": "local",
    "auto_detect_interface": true
  }
}
